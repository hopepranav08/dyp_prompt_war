# Google Cloud project used for Vertex AI (Gemini) and Firestore. Auth via ADC, so no AI key is needed.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash

# Server-side Maps key (Places, Routes, Weather, Air Quality). Kept in Secret Manager in production.
MAPS_SERVER_KEY=

# Browser Maps JS key. Public by design: restrict it to Maps JS API + your HTTP referrers.
VITE_MAPS_BROWSER_KEY=

# firestore | memory
REPORT_STORE=firestore
